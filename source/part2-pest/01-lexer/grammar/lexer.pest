// Part 2: Grammar-driven lexer (pest)
// Token rules for Lumina

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

// Keywords
let_kw    = { "let" }
fn_kw     = { "fn" }
type_kw   = { "type" }
match_kw  = { "match" }
with_kw   = { "with" }
end_kw    = { "end" }
if_kw     = { "if" }
then_kw   = { "then" }
else_kw   = { "else" }

// Literals
int       = @{ ASCII_DIGIT+ }
ident     = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Symbols
eq        = { "=" }
arrow     = { "->" }
pipe      = { "|" }
lt        = { "<" }
gt        = { ">" }
comma     = { "," }
semicolon = { ";" }
lparen    = { "(" }
rparen    = { ")" }
plus      = { "+" }
minus     = { "-" }
star      = { "*" }

// Main: sequence of tokens
tokens = { SOI ~ (let_kw | fn_kw | type_kw | match_kw | with_kw | end_kw | if_kw | then_kw | else_kw | int | ident | eq | arrow | pipe | lt | gt | comma | semicolon | lparen | rparen | plus | minus | star)* ~ EOI }
